{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "sops@latest",
    "age@latest",
    "ssh-to-age@latest",
    "kubectl@latest",
    "kubernetes-helm@latest",
    "k9s@latest",
    "jq@latest",
    "git@latest"
  ],
  "shell": {
    "init_hook": [
      "echo '🚀 NixOS K8s Cluster Management'",
      "echo ''",
      "echo 'Setup secrets:    sops hosts/k8s/secrets/k8s.yaml'",
      "echo 'Build ISO:        nix build .#installer-iso'",
      "echo 'Flash USB:        open -a balenaEtcher'",
      "echo 'Deploy all:       nix run ./hosts/k8s#deploy'",
      "echo 'Deploy one:       nix run ./hosts/k8s#deploy -- ./hosts/k8s#k8s-server-1'",
      "echo ''",
      "echo 'See hosts/k8s/README.md for full instructions'"
    ]
  }
}
