{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "sops@latest",
    "age@latest",
    "ssh-to-age@latest",
    "kubectl@latest",
    "kubernetes-helm@latest",
    "k9s@latest",
    "jq@latest",
    "git@latest"
  ],
  "shell": {
    "init_hook": [
      "echo '🚀 NixOS K8s Cluster Management'",
      "echo ''",
      "echo 'Setup secrets:    sops secrets/k8s.yaml'",
      "echo 'Build ISO:        nix build .#k8s-installer-iso'",
      "echo 'Deploy all:       nix run .#deploy'",
      "echo 'Deploy one:       nix run .#deploy .#k8s-server-1'",
      "echo ''",
      "echo 'See modules/kubernetes/README.md for full instructions'"
    ]
  }
}
