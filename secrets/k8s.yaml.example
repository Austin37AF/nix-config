# Example secrets file
# 
# To create the real encrypted file:
#   1. Install sops: nix-env -iA nixpkgs.sops nixpkgs.age
#   2. Generate age key: age-keygen -o ~/.config/sops/age/keys.txt
#   3. Update .sops.yaml with your age public key
#   4. Create secrets: sops secrets/k8s.yaml
#   5. Add these values in the editor that opens:

# K3s cluster join token
# Generate with: openssl rand -hex 32
k3s-token: "your-generated-token-here"
